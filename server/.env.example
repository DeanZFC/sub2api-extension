HOST=0.0.0.0
PORT=18084

SUB2API_BASE_URL=https://ai.example.com
SUB2API_ADMIN_API_KEY=admin-replace-me
SUB2API_TIMEOUT=15s

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=sub2api_ext_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=Lax
SESSION_TTL=2h

# 默认使用 SQLite；多实例部署时设置独立 PostgreSQL DATABASE_URL（不能使用 Sub2API 业务库）。
# DATABASE_URL=postgresql://extension_user:password@postgres.example.com:5432/sub2api_extension?sslmode=require
DB_PATH=./data/extension.sqlite
LOCAL_TEST_ENABLED=false
# LOCAL_TEST_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_ENTRY=20
RATE_LIMIT_PARTICIPATE=30
RATE_LIMIT_ADMIN=120
RATE_LIMIT_WRITE=60
RATE_LIMIT_API=300
API_LOG_RETENTION_DAYS=30
OUTBOX_INTERVAL=10s
AUTO_DRAW_INTERVAL=10s
# 3 至 8 个字符；上线后请保持稳定。
REWARD_CODE_PREFIX=S2EXT-
# 页面时间、活动时间输入和每日签到日期均按此时区计算；数据库仍使用 UTC 存储。
ACTIVITY_TIME_ZONE=Asia/Shanghai
BODY_LIMIT_BYTES=262144
