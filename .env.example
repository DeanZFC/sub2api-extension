# Sub2API 地址必须是站点根地址，不要带 /api/v1。
SUB2API_BASE_URL=https://ai.example.com
# 仅服务端使用的 Sub2API 管理员 API Key，禁止放进菜单 URL 或前端代码。
SUB2API_ADMIN_API_KEY=replace-with-an-admin-api-key
SUB2API_TIMEOUT=15s

# 至少 32 个字符；可用 openssl rand -hex 32 生成。
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=sub2api_ext_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=Lax
SESSION_TTL=2h

# 仅本机临时联调时开启；生产环境必须保持 false。
LOCAL_TEST_ENABLED=false
# LOCAL_TEST_SECRET=replace-with-at-least-32-random-characters

# 使用 Nginx 并由其覆盖 X-Real-IP 时设置 true；直接暴露服务时保持 false。
TRUST_PROXY=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_ENTRY=20
RATE_LIMIT_PARTICIPATE=30
RATE_LIMIT_ADMIN=120
RATE_LIMIT_WRITE=60
RATE_LIMIT_API=300
API_LOG_RETENTION_DAYS=30

# 只填写允许嵌入扩展页面的 Sub2API origin，不要带路径或结尾斜杠。
# 多个 origin 使用空格分隔，例如：https://a.example.com https://b.example.com
FRAME_ANCESTORS=https://ai.example.com

# Docker 使用 host 网络。若 Nginx 位于另一台服务器，必须通过防火墙限制 8081 的来源。
HOST=0.0.0.0
PORT=8081
# 生产环境可设置独立 PostgreSQL 数据库；设置后优先于 DB_PATH。
# DATABASE_URL=postgresql://extension_user:password@postgres.example.com:5432/sub2api_extension?sslmode=require
DB_PATH=/app/data/extension.sqlite
PUBLIC_DIR=/app/web/dist

OUTBOX_INTERVAL=10s
AUTO_DRAW_INTERVAL=10s
GROUP_EXPIRY_INTERVAL=10s
# 3 至 8 个字符；上线后保持稳定，用于标识扩展创建的奖励兑换码。
REWARD_CODE_PREFIX=S2EXT-
# 页面时间、活动时间输入和每日签到日期均按此时区计算；数据库仍使用 UTC 存储。
ACTIVITY_TIME_ZONE=Asia/Shanghai
BODY_LIMIT_BYTES=262144
